# Reference for the variables this server reads. Nothing loads this file
# automatically: export the variables yourself, or put them in the "env" block of
# your MCP client's server configuration. A .env file you create is gitignored.

# Device connection
PANOS_HOST=firewall.example.com
# PANOS_HOSTNAME (pango's own name) is accepted as a fallback; when both are set
# PANOS_HOST wins.
# Optional. Leave unset to use the https default port.
PANOS_PORT=

# Auth: either PANOS_API_KEY, or PANOS_USERNAME plus PANOS_PASSWORD.
# When both are supplied the API key is what gets used.
PANOS_API_KEY=
PANOS_USERNAME=
PANOS_PASSWORD=

# TLS.
# PANOS_SKIP_VERIFY=true disables certificate verification against a firewall
# management plane, which exposes the session to interception. Prefer supplying
# the firewall's CA certificate below. PANOS_SKIP_VERIFY_CERTIFICATE (pango's own
# name) is accepted as a fallback; when both are set PANOS_SKIP_VERIFY wins.
PANOS_SKIP_VERIFY=false
# Path to a PEM-encoded CA certificate.
PANOS_CA_CERT=

# Behaviour.
# The server is read-only by default. Set this to a true value (true, 1, t) to
# permit writes to the candidate configuration; false, 0, unset, or empty all
# keep it read-only, the safe default. A non-boolean value is a startup error.
# This replaces the old PANOS_READ_ONLY: a non-empty PANOS_READ_ONLY now aborts
# startup, so delete that line rather than editing its value.
PANOS_ALLOW_WRITES=false
# Max seconds a commit or push waits for its job. Integer seconds, 1 to 86400.
PANOS_JOB_WAIT=120

# MCP transport. One of stdio, http.
MCP_TRANSPORT=stdio
# Bind address for the http transport. Loopback by default. A container has to
# bind the container interface instead, but note the http transport carries no
# authentication of its own, so the port must not be reachable from an untrusted
# network.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# One of debug, info, warn, error. Case-insensitive. An unrecognised value is a
# startup error. Renamed from LOG_LEVEL, which is no longer read at all: MCP
# clients pass their own environment down, so an unrelated LOG_LEVEL=debug used
# to change this server's verbosity. The name now matches pango's PANOS_LOG_LEVEL.
PANOS_LOG_LEVEL=info
