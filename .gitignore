# Planning documents are local-only and may never be committed
docs/superpowers/
docs/plans/
docs/specs/
*.plan.md
PLAN.md
PLANNING.md

# Local tooling state
.serena/
.codegraph/

# Build output
/panos-mcp-go
*.exe
dist/
.task/

# Local credentials and TLS material. PANOS_CA_CERT invites a certificate to be
# placed near the project, and this repository is public, so the whole family is
# excluded rather than the single .env filename.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
# Test fixtures are checked in on purpose. Without this the patterns above
# swallow a testdata PEM silently, with no error from git add.
!testdata/**

# Test and coverage artifacts
*.test
*.out
coverage.html
